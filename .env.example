# Copy this file to ".env" in the project root and fill in your values.
# Never commit ".env" to git.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (required)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# CORS — comma-separated frontend origins (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Business WhatsApp for product enquiry links (digits with optional +)
COMPANY_WHATSAPP=

# Public React app URL (no trailing slash) — used in WhatsApp product links
FRONTEND_BASE_URL=http://localhost:3000
